    <Component class="javax.swing.JLabel" name="jLabel7">
      <Properties>
        <Property name="text" type="java.lang.String" value="Create Your Account to Get Started   Welcome to our system &#x2014; built for speed, security, and simplicity. By creating an account, you&#x2019;ll unlock access to powerful features tailored to help you manage, track, and grow with ease.   Registration is quick and free. Your information is safe with us, and we&#x2019;re committed to giving you a seamless experience every time you log in.  Let&#x2019;s build something better &#x2014; together."/>
      </Properties>
    </Component>
